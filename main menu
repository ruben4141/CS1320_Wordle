int main() {
    srand(time(NULL)); // random seed

    showWelcome(); // <<< NEW: show welcome screen at the start

    int choice;
    do {
        showMenu(); // <<< NEW: show menu inside the loop
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                playGame(); // <<< your team's game function (already exists)
                break;
            case 2:
                showLeaderboard(); // <<< your team's leaderboard (even if empty)
                break;
            case 3:
                printf("Exiting game. Goodbye!\n");
                break;
            default:
                printf("Invalid choice. Try again.\n");
        }
    } while (choice != 3);

    return 0;
}
